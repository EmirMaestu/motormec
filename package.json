{
  "name": "motormec",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MotorMec — SaaS multi-taller (rebuild: Fastify + Drizzle + Postgres + React). Legacy Convex/Vite app remains in convex/ and src/ as functional reference only (see git history for its original package.json).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @motormec/api",
    "dev:web": "npm run dev --workspace @motormec/web",
    "build": "npm run build --workspace @motormec/api",
    "test": "npm run test --workspace @motormec/api",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "npm run db:generate --workspace @motormec/api",
    "db:migrate": "npm run db:migrate --workspace @motormec/api",
    "db:push": "npm run db:push --workspace @motormec/api"
  }
}
